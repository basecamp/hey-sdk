#!/usr/bin/env bash
# merge-behavior-model — Write the OpenAPI document the Go generator reads
#
# oapi-codegen hands its templates the OpenAPI document and nothing else, but whether
# an operation may be resent is the behavior model's to say as much as the spec's. This
# decides it for every operation, as the TypeScript, Rust and Kotlin generators decide
# it from behavior-model.json themselves, and writes the verdict onto the operation as
# x-go-idempotent, a hint for go/templates/client.tmpl in the vein of the x-go-type
# hints enhance-openapi-go-types.sh adds:
#
#   1. The x-hey-idempotent override has the first word, in either direction —
#      natural: true opts a POST in, natural: false opts a PUT out (UpdateMessage
#      delivers).
#   2. Otherwise the behavior model's: a read, or an operation the Smithy model marks
#      @idempotent, which is how a PATCH earns a resend.
#   3. The verb stands in when the model says neither: GET, HEAD, PUT and DELETE.
#
# The account filter expand-account-scope declares (x-hey-account-scope) is left out, as
# every generator leaves it out: the Go transport already sends it.
#
# Every optional array property of a response-side schema is marked x-omitempty: false
# and x-omitzero: true, so oapi-codegen tags its slice `json:"name,omitzero"` rather than
# `json:"name,omitempty"`. omitempty drops a non-nil empty slice, so a `[]` HEY sent
# vanished from anything that re-marshaled the response; omitzero (Go 1.24+) drops only a
# nil slice, so an absent key stays absent and a sent `[]` stays `[]`. The generator's
# prefer-skip-optional-pointer-with-omitzero option can't do this: it adds omitzero
# beside omitempty, and omitempty still drops the empty slice.
#
# A schema reachable from any request body (the Rust generator's request side) keeps
# omitempty: there an empty slice is the caller's own value, and callers build recipient
# and alias lists that are empty-but-non-nil and rely on the key being left out. No schema
# is on both sides today; one that became so would keep omitempty.
#
# An operation with no behavior-model.json entry fails the build, as it does in the
# TypeScript generator.
#
# Usage: merge-behavior-model OPENAPI BEHAVIOR_MODEL OUTPUT
set -euo pipefail

if [[ $# -ne 3 ]]; then
    echo "usage: $0 OPENAPI BEHAVIOR_MODEL OUTPUT" >&2
    exit 2
fi

OPENAPI_FILE="$1"
MODEL_FILE="$2"
OUTPUT_FILE="$3"

if ! command -v jq &> /dev/null; then
    echo "ERROR: jq is required but not installed." >&2
    exit 1
fi

jq --slurpfile model "$MODEL_FILE" '
  def schema_refs: [.. | objects | select(has("$ref")) | .["$ref"] | sub("^#/components/schemas/"; "")];
  def closure($schemas):
    {seen: [], todo: .}
    | until(.todo == [];
        .todo[0] as $name
        | .todo |= .[1:]
        | if (.seen | index([$name])) then . else
            .seen += [$name] | .todo += ($schemas[$name] | schema_refs)
          end)
    | .seen;
  $model[0].operations as $operations
  | .paths |= with_entries(
      .value |= with_entries(
        .key as $method
        | if (.value | type) == "object" and .value.operationId != null then
            .value.operationId as $id
            | ($operations[$id] // error("\($id) has no entry in behavior-model.json")) as $semantics
            | .value["x-go-idempotent"] = (
                if (.value["x-hey-idempotent"].natural | type) == "boolean" then
                  .value["x-hey-idempotent"].natural
                else
                  $semantics.readonly == true
                  or $semantics.idempotent == true
                  or ($method | IN("get", "head", "put", "delete"))
                end
              )
            | if .value.parameters then
                .value.parameters |= map(select(has("x-hey-account-scope") | not))
                | if .value.parameters == [] then del(.value.parameters) else . end
              else . end
          else . end
      )
    )
  | (.components.schemas // {}) as $schemas
  | ([.paths[][] | objects | .requestBody // empty | schema_refs[]] | unique
      | closure($schemas)) as $request_side
  | if .components.schemas == null then . else .components.schemas |= with_entries(
      if .key | IN($request_side[]) then . else
        .value |= walk(
          if type == "object" and (.properties | type) == "object" then
            (.required // []) as $required
            | .properties |= with_entries(
                if .value.type == "array" and (.key | IN($required[]) | not) then
                  .value["x-omitempty"] = false | .value["x-omitzero"] = true
                else . end
              )
          else . end
        )
      end
    ) end
' "$OPENAPI_FILE" > "$OUTPUT_FILE"
