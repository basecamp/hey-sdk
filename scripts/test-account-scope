#!/usr/bin/env bash
# test-account-scope — prove the account filter is declared on signed operations alone
#
# scripts/expand-account-scope declares the account filter on every operation that takes
# the bearer token, and scripts/merge-behavior-model takes it off again for the Go
# generator, whose transport already sends it. This runs both on a small document and on
# broken copies of it, and fails unless the expansion declares the filter where it should,
# refuses every copy it cannot expand safely (leaving the file as it was), and the Go input
# loses the marked parameter and nothing else.
#
# Usage: scripts/test-account-scope   (from anywhere; needs jq)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EXPAND="$SCRIPT_DIR/expand-account-scope"
MERGE="$SCRIPT_DIR/merge-behavior-model"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

failures=0
ok() { echo "  ok: $1"; }
fail() { echo "  FAIL: $1" >&2; failures=$((failures + 1)); }

cat > "$WORK/base.json" <<'JSON'
{
  "openapi": "3.0.2",
  "x-hey-account-scope": {"query": "filtered_account_id"},
  "security": [{"smithy.api.httpBearerAuth": []}],
  "paths": {
    "/boxes.json": {"get": {"operationId": "ListBoxes", "parameters": [{"name": "page", "in": "query", "schema": {"type": "string"}}]}},
    "/boxes/{boxId}": {"put": {"operationId": "UpdateBox", "security": [{"smithy.api.httpBearerAuth": []}], "parameters": [{"name": "boxId", "in": "path", "required": true, "schema": {"type": "integer", "format": "int64"}}]}},
    "/identity.json": {"get": {"operationId": "GetIdentity"}},
    "/oauth/tokens.json": {"post": {"operationId": "CreateToken", "security": [], "x-hey-unsigned": {}}}
  }
}
JSON

# The document with every marked parameter taken off, and a list that leaves empty dropped.
strip='.paths[][] |= (if type == "object" and .parameters then .parameters |= map(select(has("x-hey-account-scope") | not)) | if .parameters == [] then del(.parameters) else . end else . end)'

echo "==> Expanding a document with signed and unsigned operations..."
cp "$WORK/base.json" "$WORK/expanded.json"
expanded=false
if ! "$EXPAND" "$WORK/expanded.json" 2> "$WORK/expand.err"; then
    fail "the unbroken document was refused: $(cat "$WORK/expand.err")"
else
    expanded=true
    names() { jq -c --arg id "$1" '[.paths[][] | select(.operationId? == $id) | (.parameters // [])[] | .name]' "$WORK/expanded.json"; }
    [[ $(names ListBoxes) == '["page","filtered_account_id"]' ]] && ok "ListBoxes keeps page and gains the filter" || fail "ListBoxes has $(names ListBoxes)"
    [[ $(names UpdateBox) == '["boxId","filtered_account_id"]' ]] && ok "a write with its own security gains the filter" || fail "UpdateBox has $(names UpdateBox)"
    [[ $(names GetIdentity) == '["filtered_account_id"]' ]] && ok "an operation with no parameters gains the filter" || fail "GetIdentity has $(names GetIdentity)"
    jq -e '.paths["/oauth/tokens.json"].post | has("parameters") | not' "$WORK/expanded.json" > /dev/null \
        && ok "the unsigned CreateToken is left alone" || fail "CreateToken gained parameters"
    jq -e '[.paths[][] | (.parameters // [])[] | select(.name == "filtered_account_id")]
           | length == 3 and all(.in == "query" and .required == false and .schema == {type: "integer", format: "int64"}
                                 and ."x-hey-account-scope" == true and (.description | type == "string" and length > 0))' \
        "$WORK/expanded.json" > /dev/null \
        && ok "each declaration is an optional int64 query parameter, described and marked" || fail "a declaration has the wrong shape"
    [[ $(jq -S "$strip" "$WORK/expanded.json") == "$(jq -S . "$WORK/base.json")" ]] \
        && ok "taking the marked parameters off gives back the document" || fail "the expansion changed more than the marked parameters"
fi

echo "==> Refusing documents the expansion cannot read safely..."
refuse() {
    local name="$1" expected="$2" mutation="$3" file="$WORK/case.json" before
    jq "$mutation" "$WORK/base.json" > "$file"
    before=$(cat "$file")
    if "$EXPAND" "$file" 2> "$WORK/case.err"; then
        fail "$name: the expansion accepted it"
    elif ! grep -qF -- "$expected" "$WORK/case.err"; then
        fail "$name: refused, but without \"$expected\": $(cat "$WORK/case.err")"
    elif [[ $(cat "$file") != "$before" ]]; then
        fail "$name: refused, but the file was changed"
    else
        ok "$name"
    fi
}
refuse "no @heyAccountScope on the service" "x-hey-account-scope" 'del(.["x-hey-account-scope"])'
refuse "an empty query name" "x-hey-account-scope" '.["x-hey-account-scope"].query = ""'
refuse "a query name that is not a string" "x-hey-account-scope" '.["x-hey-account-scope"].query = 5'
refuse "an empty security without x-hey-unsigned" "CreateToken" 'del(.paths["/oauth/tokens.json"].post["x-hey-unsigned"])'
refuse "x-hey-unsigned on a signed operation" "ListBoxes" '.paths["/boxes.json"].get["x-hey-unsigned"] = {}'
refuse "an operation opting out of security without x-hey-unsigned" "UpdateBox" '.paths["/boxes/{boxId}"].put.security = []'
refuse "no service-wide security" "ListBoxes" 'del(.security)'
refuse "an operation already declaring the filter" "ListBoxes already declares filtered_account_id" \
    '.paths["/boxes.json"].get.parameters += [{"name": "filtered_account_id", "in": "query", "schema": {"type": "string"}}]'
refuse "an unsigned operation declaring the filter" "CreateToken already declares filtered_account_id" \
    '.paths["/oauth/tokens.json"].post.parameters = [{"name": "filtered_account_id", "in": "query", "schema": {"type": "string"}}]'
refuse "a path declaring the filter for its operations" "/boxes.json already declares filtered_account_id" \
    '.paths["/boxes.json"].parameters = [{"name": "filtered_account_id", "in": "query", "schema": {"type": "integer"}}]'
refuse "a referenced parameter on an operation" "ListBoxes: a \$ref parameter" \
    '.paths["/boxes.json"].get.parameters += [{"$ref": "#/components/parameters/Filter"}]'
refuse "a referenced parameter on a path" "/boxes.json: a \$ref parameter" \
    '.paths["/boxes.json"].parameters = [{"$ref": "#/components/parameters/Filter"}]'
refuse "a referenced path item" "/identity.json: a \$ref path item" \
    '.paths["/identity.json"] = {"$ref": "#/components/pathItems/Identity"}'
refuse "an operation with no operationId" "get /identity.json" 'del(.paths["/identity.json"].get.operationId)'
if ! $expanded; then
    fail "expanding twice needs an expanded document"
else
    cp "$WORK/expanded.json" "$WORK/twice.json"
    if "$EXPAND" "$WORK/twice.json" 2> /dev/null; then
        fail "an expanded document was expanded again"
    else
        ok "an expanded document is refused rather than expanded twice"
    fi
fi

echo "==> Leaving the marked filter out of the Go generator's input..."
$expanded || fail "the Go input needs an expanded document"
jq '.paths["/legacy.json"] = {"get": {"operationId": "ListLegacy",
      "parameters": [{"name": "filtered_account_id", "in": "query", "schema": {"type": "integer", "format": "int64"}}]}}' \
    "$WORK/expanded.json" > "$WORK/go-in.json"
jq -n '{operations: {ListBoxes: {readonly: true}, UpdateBox: {}, GetIdentity: {readonly: true}, CreateToken: {}, ListLegacy: {readonly: true}}}' \
    > "$WORK/behavior.json"
if ! $expanded; then
    :
elif ! "$MERGE" "$WORK/go-in.json" "$WORK/behavior.json" "$WORK/go-out.json" 2> "$WORK/merge.err"; then
    fail "merge-behavior-model refused the expanded document: $(cat "$WORK/merge.err")"
else
    [[ $(jq -S 'del(.paths[][]["x-go-idempotent"])' "$WORK/go-out.json") == "$(jq -S "$strip" "$WORK/go-in.json")" ]] \
        && ok "only the marked parameters are gone, and the lists they leave empty" \
        || fail "the Go input differs from the document without its marked parameters"
    jq -e '.paths["/legacy.json"].get.parameters | map(.name) == ["filtered_account_id"]' "$WORK/go-out.json" > /dev/null \
        && ok "an unmarked parameter of the same name stays" || fail "the unmarked filtered_account_id was dropped"
fi

if [[ $failures -gt 0 ]]; then
    echo "==> $failures account-scope check(s) failed" >&2
    exit 1
fi
echo "==> Account-scope checks passed"
